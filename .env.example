# X API
# Create an app in the X Developer Console and keep this secret on the server.
X_BEARER_TOKEN=

# Server
PORT=3000
HOST=0.0.0.0

# Initial archive sync: 1-100 pages.
SYNC_MAX_PAGES=32

# Set true only when your X API access includes Full-Archive Search.
# This can incur pay-per-use API usage charges.
X_FULL_ARCHIVE=false
